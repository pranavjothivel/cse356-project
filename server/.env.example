# server/.env example — copy to server/.env and fill in real values.
# Production-equivalents are sanitized; the structure mirrors what runs in prod.

# ────── Database ──────
# In prod the app connects through the per-node PgBouncer on 127.0.0.1:6432;
# PG_DIRECT_URL is the real Postgres (used by migrations / admin tasks).
DATABASE_URL=postgres://app_user:app_password@127.0.0.1:6432/cse356
PG_DIRECT_URL=postgres://app_user:app_password@postgres.internal:5432/cse356

# ────── Frontend ──────
# Used for CORS allow-list and OAuth redirect targets.
FRONTEND_URL=https://example.cse356.compas.cs.stonybrook.edu
BASE_URL=https://example.cse356.compas.cs.stonybrook.edu

# ────── Redis ──────
# REDIS_URL = sessions / cache / presence / mutex (Redis 01).
# REDIS_PUBLISH_URL = dedicated pub/sub fanout instance (Redis 02). Falls back
# to REDIS_URL if absent (single-instance dev mode).
REDIS_URL=redis://redis-01.internal:6379
REDIS_PUBLISH_URL=redis://redis-02.internal:6380

# ────── Session / JWT ──────
SESSION_SECRET=replace-with-a-random-hex-string-at-least-32-chars
JWT_SECRET=replace-with-a-random-hex-string-at-least-32-chars

# ────── OAuth (Google) ──────
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALLBACK_URL=https://example.cse356.compas.cs.stonybrook.edu/api/auth/google/callback

# ────── OAuth (GitHub) ──────
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=https://example.cse356.compas.cs.stonybrook.edu/api/auth/github/callback

# ────── OIDC (course Keycloak) ──────
OIDC_ISSUER=https://infra-auth.cse356.compas.cs.stonybrook.edu/realms/oauth
OIDC_CLIENT_ID=web-service
OIDC_CLIENT_SECRET=your-oidc-client-secret
OIDC_CALLBACK_URL=https://example.cse356.compas.cs.stonybrook.edu/api/auth/oidc/callback

# ────── Runtime ──────
NODE_ENV=production
PORT=3000
# WORKER_ROLE = 'all' (default), 'http' (skip WS server), or 'ws' (skip API).
# Injected per-node by the deploy pipeline based on flags in infra/nodes.yml.
WORKER_ROLE=all

# ────── MinIO (S3-compatible object storage for attachments) ──────
MINIO_HOST=minio.internal
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key

# ────── Observability (optional) ──────
# Sentry was disabled in the live codepath after a perf/value tradeoff,
# but the env vars remain for re-enable.
SENTRY_DSN=https://your-sentry-dsn@example.ingest.sentry.io/project-id

# Axiom for HAProxy live log streaming (set on telemetry / LB nodes).
AXIOM_TOKEN=your-axiom-api-token

# OpenTelemetry → Grafana Cloud (via Alloy on the telemetry node).
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_SERVICE_NAME=cse356-server
OTEL_RESOURCE_ATTRIBUTES=service.namespace=cse356,deployment.environment=production
