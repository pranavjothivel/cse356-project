%% Production topology — cse356 messaging system.
%% Components: HAProxy LB, API pool, WS pool, PgBouncer, Redis 01
%% (sessions/cache/queue/presence), Redis 02 (pub/sub fanout), PostgreSQL, MinIO.
flowchart TB
    Clients["Clients<br/>(browser React SPA,<br/>course grading load generator clients,<br/>and our ad-hoc loadgen clients)"]

    LB["HAProxy + Nginx<br/>(the LB)"]

    subgraph API["API pool — WORKER_ROLE=http/all"]
        direction LR
        API1["group1-api-node-01"]
        API2["group1-api-node-02"]
        API3["group1-api-node-03"]
        APIHTTP["group1-api-node-http-01"]
    end

    subgraph WS["WS pool — WORKER_ROLE=ws, node ws library on :3000"]
        direction LR
        WS04["group1-api-node-04"]
        WS05["group1-api-node-05"]
        WS06["group1-api-node-06"]
        WS07["group1-api-node-07"]
    end

    PGB["PgBouncer<br/>(local pooler on each app node)"]

    subgraph Stores["Shared state"]
        direction LR
        PG[("group1-db-psql-01<br/>PostgreSQL")]
        R1[("group1-db-redis-01<br/>sessions • cache / queue • presence")]
        R2[("group1-db-redis-02<br/>pub/sub fanout")]
        MINIO[("MinIO<br/>S3-compatible<br/>object storage")]
    end

    Clients -- HTTPS / WSS --> LB
    LB -- /api/* --> API
    LB -- WS upgrade --> WS
    LB -- /minio/* proxy --> MINIO

    API -- SQL --> PGB
    WS  -- SQL --> PGB
    PGB -- pooled --> PG

    API -- sessions / cache / queue / presence --> R1
    WS  -- presence --> R1

    API -- PUBLISH --> R2
    WS  -- SUBSCRIBE --> R2

    API -- attachment upload --> MINIO

    classDef lb fill:#fde68a,stroke:#b45309,stroke-width:1px,color:#000
    classDef api fill:#bfdbfe,stroke:#1d4ed8,stroke-width:1px,color:#000
    classDef ws fill:#bbf7d0,stroke:#15803d,stroke-width:1px,color:#000
    classDef pool fill:#fef3c7,stroke:#a16207,stroke-width:1px,color:#000
    classDef store fill:#f3e8ff,stroke:#7e22ce,stroke-width:1px,color:#000
    classDef cli fill:#e5e7eb,stroke:#374151,stroke-width:1px,color:#000

    class LB lb
    class API1,API2,API3,APIHTTP api
    class WS04,WS05,WS06,WS07 ws
    class PGB pool
    class PG,R1,R2,MINIO store
    class Clients cli
